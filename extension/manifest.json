{
  "manifest_version": 3,
  "name": "__MSG_manifest_name__",
  "short_name": "__MSG_manifest_short_name__",
  "version": "0.8.384",
  "default_locale": "en",
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon.png" },
  "description": "__MSG_manifest_description__",
  "omnibox": { "keyword": "et" },
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "contextMenus",
    "search",
    "sessions",
    "sidePanel"
  ],
  "optional_permissions": ["history", "tabGroups"],
  "side_panel": { "default_path": "sidepanel.html" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_manifest_action_title__",
    "default_icon": { "16": "icon16.png", "24": "icon24.png", "32": "icon32.png", "48": "icon48.png", "128": "icon.png" }
  },
  "options_page": "options.html",
  "commands": {
    "open-search-popup": {
      "suggested_key": { "default": "Alt+Shift+K", "mac": "MacCtrl+Shift+K" },
      "description": "__MSG_command_search_description__"
    },
    "open-dashboard": {
      "suggested_key": { "default": "Alt+Shift+D", "mac": "MacCtrl+Shift+D" },
      "description": "__MSG_command_dashboard_description__"
    },
    "open-side-panel": {
      "description": "__MSG_command_side_panel_description__"
    },
    "dump-window": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "MacCtrl+Shift+S" },
      "description": "__MSG_command_save_window_description__"
    },
    "dump-tab": {
      "description": "__MSG_command_save_tab_description__"
    },
    "snooze-tab": {
      "description": "__MSG_command_snooze_tab_description__"
    },
    "suspend-tab": {
      "description": "__MSG_command_suspend_tab_description__"
    }
  }
}
